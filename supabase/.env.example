# Local Supabase function environment only. Never commit real values here.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
REDEMPTION_PEPPER=replace-with-local-only-pepper
REDEMPTION_PEPPER_VERSION=1
PAYMENT_WEBHOOK_SECRET_LOCAL=replace-with-local-only-webhook-secret
PLATFORM_RUNTIME_ENVIRONMENT=local
PLATFORM_CLEANUP_SESSION_GRACE_SECONDS=86400
PLATFORM_CLEANUP_SECURITY_CONTEXT_RETENTION_SECONDS=2592000
PLATFORM_CLEANUP_IDEMPOTENCY_RESPONSE_RETENTION_SECONDS=0
PLATFORM_CLEANUP_BATCH_SIZE=100
PLATFORM_CLEANUP_DRY_RUN=false
PLATFORM_ALERT_REQUEST_LATENCY_P95_MS=1000
PLATFORM_ALERT_ENTITLEMENT_ERROR_RATE=0.05
PLATFORM_ALERT_WEBHOOK_SIGNATURE_FAILURE_RATE=0.10
PLATFORM_ALERT_SERVICE_ROLE_ANOMALY_COUNT=5
