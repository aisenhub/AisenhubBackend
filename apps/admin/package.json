{
  "name": "@aisenhub/admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "pnpm --filter @aisenhub/contracts build && pnpm --filter @aisenhub/admin-client build && pnpm --filter @aisenhub/design-system build",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:a11y": "pnpm --dir ../.. exec playwright test tests/e2e/admin-operations.spec.ts --grep A11Y --workers=1"
  },
  "dependencies": {
    "@aisenhub/auth-client": "workspace:*",
    "@aisenhub/admin-client": "workspace:*",
    "@aisenhub/contracts": "workspace:*",
    "@aisenhub/design-system": "workspace:*",
    "@refinedev/antd": "6.0.3",
    "@refinedev/core": "5.0.12",
    "antd": "6.6.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
