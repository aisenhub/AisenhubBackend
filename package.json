{
  "name": "@aisenhub/platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.base.json --noEmit",
    "pretest": "node scripts/build-contracts.mjs",
    "test": "vitest run --passWithNoTests",
    "build": "pnpm --if-present -r run build",
    "clean-safe": "pnpm --if-present -r run clean",
    "boundaries:check": "node scripts/check-boundaries.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "rls:test": "node scripts/test-rls.mjs",
    "supabase:functions:serve": "supabase functions serve --no-verify-jwt",
    "supabase:typegen": "node scripts/generate-supabase-types.mjs",
    "functions:test": "node scripts/test-functions.mjs",
    "test:contract": "pnpm --filter @aisenhub/contracts test",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:harness:negative": "node scripts/test-harness-negative.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.1",
    "eslint": "10.9.1",
    "globals": "16.4.0",
    "prettier": "3.9.6",
    "supabase": "2.116.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  }
}
